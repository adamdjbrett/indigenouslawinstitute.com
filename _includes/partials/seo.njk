{# Set title with DEV prefix in development mode #}
{%- set pageTitle = title or metadata.title -%}
{%- if not production -%}{%- set pageTitle = "DEV - " + pageTitle -%}{%- endif -%}

{# Set description and image with fallbacks #}
{%- set pageDescription = description or metadata.description -%}
{%- set pageImage = image or metadata.image -%}
{%- set pageCanonical = canonical_url or metadata.url + page.url -%}

<title>{{pageTitle}}</title>
<meta name="description" content="{{pageDescription}}" />
<link rel="canonical" href="{{ pageCanonical }}" />

{# Open Graph / Facebook #}
<meta property="og:type" content="website" />
<meta property="og:title" content="{{pageTitle}}" />
<meta property="og:description" content="{{pageDescription}}" />
<meta property="og:image" content="{{pageImage}}" />
<meta property="og:locale" content="{{ metadata.locale }}" />
<meta property="og:site_name" content="{{metadata.title}}" />

{# Twitter Card #}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{pageTitle}}" />
<meta name="twitter:description" content="{{pageDescription}}" />
<meta name="twitter:image" content="{{pageImage}}" />
<meta name="twitter:site" content="{{ metadata.metasocial.twitter }}" />
<meta name="twitter:creator" content="{{ metadata.metasocial.twitteruser }}" />

{# Dublin Core #}
<meta property="dc:title" content="{{pageTitle}}" />
<meta property="dc:creator" content="{{ metadata.author.name }}" />

{# Favicon #}
<link rel="icon" type="image/png" href="/img/favicon/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/img/favicon/favicon.svg" />
<link rel="shortcut icon" href="/img/favicon/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/img/favicon/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="ILI" />
<link rel="manifest" href="/img/favicon/site.webmanifest" />

{# Other meta #}
<meta name="robots" content="index, follow" />
<meta name="language" content="{{ metadata.language }}" />

{# Optional: eleventy-plugin-seo output #}
{%- if use_plugin_seo -%}
<!-- plugin-seo: begin -->
{% seo "" %}
<!-- plugin-seo: end -->
{%- endif -%}
<meta name="language" content="{{ metadata.language }}" />
<meta name="locale" content="{{ metadata.locale }}" />
<meta property="og:locale" content="{{ metadata.locale }}" />
<meta name="generator" content="{{ eleventy.generator }}" />
<link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">
<style>{% include "css/bs.css" %}</style>
<link rel="stylesheet" href="{% getBundleFileUrl "css" %}">
<link rel="stylesheet" href="/css/index.css">
<script type="module">{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": {{ (metadata.url + "/#website") | dump | safe }},
      "name": {{ metadata.title | dump | safe }},
      "description": {{ metadata.description | dump | safe }},
      "url": {{ (metadata.url + "/") | dump | safe }},
      "inLanguage": {{ metadata.language | dump | safe }},
      "publisher": { "@id": {{ (metadata.url + "/#organization") | dump | safe }} }
    },
    {
      "@type": "EducationalOrganization",
      "@id": {{ (metadata.url + "/#organization") | dump | safe }},
      "name": {{ metadata.title | dump | safe }},
      "description": {{ metadata.description | dump | safe }},
      "url": {{ (metadata.url + "/") | dump | safe }},
      "founder": [
        { "@id": {{ (metadata.url + "/authors/birgil-kills-straight/#person") | dump | safe }} },
        { "@id": {{ (metadata.url + "/authors/steven-newcomb/#person") | dump | safe }} }
      ]
    },
    {% for authorPage in collections.authors %}{
      "@type": "Person",
      "@id": {{ (metadata.url + authorPage.url + "#person") | dump | safe }},
      "name": {{ authorPage.data.name | dump | safe }},
      "url": {{ (metadata.url + authorPage.url) | dump | safe }},
      "description": {{ authorPage.data.bio | dump | safe }}{% if authorPage.data.organization %},
      "affiliation": { "@type": "Organization", "name": {{ authorPage.data.organization | dump | safe }} }{% endif %}{% if authorPage.data.birthDate %},
      "birthDate": {{ authorPage.data.birthDate | dump | safe }}{% endif %}{% if authorPage.data.deathDate %},
      "deathDate": {{ authorPage.data.deathDate | dump | safe }}{% endif %}{% if authorPage.data.sameAs %},
      "sameAs": {{ authorPage.data.sameAs | dump | safe }}{% endif %}
    }{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
</script>

{# Zotero / Highwire / PRISM — makes posts harvestable as Blog Post type #}
{% set isPost = layout == 'post' or "posts" in (tags or []) %}
{% if isPost %}
{% set authorKeys = author | authorsToArray %}
{% set authorNames = authorKeys | authorsToNames(collections.authors) %}
<link rel="cite-as" href="{{ pageCanonical }}">
<link rel="type" href="https://schema.org/BlogPosting">
{% if authorKeys.length %}{% for authorPage in collections.authors %}{% if authorPage.page.fileSlug in authorKeys %}<link rel="author" href="{{ metadata.url }}{{ authorPage.url }}">
{% endif %}{% endfor %}{% else %}<link rel="author" href="{{ metadata.url }}">
{% endif %}
<link rel="describedby" type="application/ld+json" profile="https://schema.org/" href="{{ page.url }}metadata.json">
<meta property="zotero:itemType" content="blogPost" />
<meta property="dc:title" content="{{ pageTitle | escape }}" />
{% for authorName in authorNames %}<meta property="dc:creator" content="{{ authorName | escape }}" />
{% else %}<meta property="dc:creator" content="Indigenous Law Institute" />
{% endfor %}
{% if date %}<meta property="dc:date" content="{{ date | date('Y-m-d') }}" />{% endif %}
<meta property="dc:language" content="{{ metadata.language }}" />
<meta property="dc:identifier" content="{{ pageCanonical }}" />
<meta name="citation_title" content="{{ pageTitle | escape }}" />
{% for authorName in authorNames %}<meta name="citation_author" content="{{ authorName | escape }}" />
{% else %}<meta name="citation_author" content="Indigenous Law Institute" />
{% endfor %}
{% if date %}<meta name="citation_publication_date" content="{{ date | date('Y-m-d') }}" />{% endif %}
<meta name="citation_fulltext_html_url" content="{{ pageCanonical }}" />
<meta name="citation_public_url" content="{{ pageCanonical }}" />
<meta name="citation_language" content="{{ metadata.language }}" />
{% if doi %}<meta name="citation_doi" content="{{ doi | escape }}" />{% endif %}
<meta name="prism.genre" content="blogentry" />
<meta name="prism.publicationName" content="Indigenous Law Institute" />
{% endif %}
